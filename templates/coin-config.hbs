<div class="glfc-coin-config-form">
  <p class="notes">{{reloadHint}}</p>

  <fieldset class="glfc-config-fieldset">
    <legend>{{labelGoodFieldLabel}} / {{labelBadFieldLabel}}</legend>
    <div class="glfc-config-labels">
      <label>
        <span>{{labelGoodFieldLabel}}</span>
        <input type="text" name="{{labelGoodName}}" value="{{labelGood}}" />
      </label>
      <label>
        <span>{{labelBadFieldLabel}}</span>
        <input type="text" name="{{labelBadName}}" value="{{labelBad}}" />
      </label>
    </div>
  </fieldset>

  {{#each faces}}
    <fieldset class="glfc-config-fieldset">
      <legend>{{this.label}}</legend>
      {{#each this.maps}}
        <label class="glfc-config-map">
          <span>{{this.label}}</span>
          <div class="glfc-config-file">
            <input type="text" name="{{this.name}}" value="{{this.value}}" />
            <button type="button" data-action="browse" data-field="{{this.name}}" data-picker-type="image" data-tooltip="{{../../browseLabel}}">
              <i class="fa-solid fa-folder-open"></i>
            </button>
          </div>
        </label>
      {{/each}}
    </fieldset>
  {{/each}}

  <fieldset class="glfc-config-fieldset">
    <legend>{{edge.label}}</legend>
    <label class="glfc-config-map">
      <span>{{edge.textureLabel}}</span>
      <div class="glfc-config-file">
        <input type="text" name="{{edge.name}}" value="{{edge.value}}" />
        <button type="button" data-action="browse" data-field="{{edge.name}}" data-picker-type="image" data-tooltip="{{browseLabel}}">
          <i class="fa-solid fa-folder-open"></i>
        </button>
      </div>
    </label>
  </fieldset>

  <fieldset class="glfc-config-fieldset">
    <legend>{{localize "GLFC.Config.Sounds"}}</legend>
    {{#each sounds}}
      <label class="glfc-config-map">
        <span>{{this.label}}</span>
        <div class="glfc-config-file">
          <input type="text" name="{{this.name}}" value="{{this.value}}" />
          <button type="button" data-action="browse" data-field="{{this.name}}" data-picker-type="audio" data-tooltip="{{../browseLabel}}">
            <i class="fa-solid fa-folder-open"></i>
          </button>
        </div>
      </label>
    {{/each}}
  </fieldset>

  <footer class="sheet-footer flexrow">
    <button type="submit">
      <i class="fa-solid fa-save"></i>
      Save
    </button>
  </footer>
</div>
